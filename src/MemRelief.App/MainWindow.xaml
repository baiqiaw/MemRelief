<Window x:Class="MemRelief.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="640" Width="960">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel>
        <!-- 顶部概览条（R05；三数值精排与口径说明文案归 T-17，此处骨架绑定摘要） -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="#F4F4F4">
            <StackPanel>
                <TextBlock Text="{Binding OverviewSummary}" FontSize="14" />
                <TextBlock Text="{Binding StatusText}" Foreground="Gray" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- 底部操作栏：开始扫描/一键释放/结果摘要；控件可用性=状态机矩阵唯一投影 -->
        <Border DockPanel.Dock="Bottom" Padding="12,8" Background="#F4F4F4">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding StartScanCommand}" Content="开始扫描" MinWidth="96" MinHeight="28" />
                    <!-- 释放编排与确认弹窗归 T-16；本包仅按矩阵承载禁用态 -->
                    <Button Content="一键释放" MinWidth="96" MinHeight="28" Margin="8,0,0,0"
                            IsEnabled="{Binding Availability.ReleaseEnabled}" />
                    <ProgressBar IsIndeterminate="True" Width="120" Height="14" Margin="16,0,0,0"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <!-- 扫描失败提示（PRD §3.7“扫描失败”行；与零推荐空态严格区分） -->
                <TextBlock Text="{Binding ScanFailedMessage}" Foreground="Red" Margin="0,6,0,0"
                           Visibility="{Binding HasScanFailed, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- 搜索框：全量判定查询归 T-15（IRulesEngine.Query），本包承载布局与禁用态 -->
        <Border DockPanel.Dock="Top" Padding="12,8">
            <TextBox IsEnabled="{Binding Availability.ListInputEnabled}"
                     MaxWidth="420" HorizontalAlignment="Left"
                     ToolTip="输入进程名查询判定结果与依据" />
        </Border>

        <!-- 中部列表区：三级分组/勾选/展开/右键归 T-15/T-16，此处骨架行承载扫描编排产物 -->
        <ListBox ItemsSource="{Binding Classifications}"
                 IsEnabled="{Binding Availability.ListInputEnabled}"
                 Padding="8" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Pid}" />
                        <TextBlock Grid.Column="1" Text="{Binding Level}" Margin="12,0" />
                        <TextBlock Grid.Column="2" Text="{Binding TreePrivateBytes}" Margin="12,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
