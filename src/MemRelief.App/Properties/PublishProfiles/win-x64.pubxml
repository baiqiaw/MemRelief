<!-- 单文件自包含发布配置（T-19 / issue #21）：dotnet publish src/MemRelief.App -c Release -p:PublishProfile=win-x64 -->
<!-- 仅发布通道生效，不影响日常 dotnet build（走 profile 而非 csproj，普通构建不携带 RID/单文件属性） -->
<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF 原生依赖（wpfgfx/PenImc/D3DCompiler/vcruntime）随包自解压，publish 目录才只剩一个 exe -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 省去未用语言的框架资源程序集（数 MB）并保留简中框架异常消息，与界面语言一致；
         net10 单文件发布本就会把 satellite 程序集打进 exe，此属性不减文件数只减体积 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 自用免安装：产物不附带 pdb；本行只关 App 自身，Core 等引用工程的 pdb 由下行阻断拷贝 -->
    <DebugType>None</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
