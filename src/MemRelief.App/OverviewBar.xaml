<UserControl x:Class="MemRelief.App.OverviewBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 顶部内存概览条（R05/T-17）：三数值 + 口径说明文案；数据面=OverviewBarViewModel（独立子 VM，
         三时点刷新承载于该 VM，见其注释）。降级/读失败时备用位与三数值分别显示“—” -->
    <Border Padding="12,8" Background="#F4F4F4">
        <StackPanel>
            <TextBlock FontSize="13">
                <Run Text="使用中 " Foreground="Gray" />
                <Run Text="{Binding InUseText, Mode=OneWay}" FontWeight="Bold" />
                <Run Text=" / " Foreground="Gray" />
                <Run Text="{Binding TotalText, Mode=OneWay}" />
                <Run Text="（占用 " Foreground="Gray" />
                <Run Text="{Binding InUsePercentText, Mode=OneWay}" FontWeight="Bold" />
                <Run Text="）　　已提交 " Foreground="Gray" />
                <Run Text="{Binding CommitText, Mode=OneWay}" FontWeight="Bold" />
                <Run Text=" / " Foreground="Gray" />
                <Run Text="{Binding CommitLimitText, Mode=OneWay}" />
                <Run Text="　　备用（可回收缓存）" Foreground="Gray" />
                <Run Text="{Binding StandbyText, Mode=OneWay}" FontWeight="Bold" />
            </TextBlock>
            <TextBlock Margin="0,3,0,0" FontSize="11" Text="{Binding NoteText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="Gray" />
                        <Style.Triggers>
                            <!-- 读失败提示着色（深橙，红色留给扫描失败行）；降级注记保持灰 -->
                            <DataTrigger Binding="{Binding HasReadFailure}" Value="True">
                                <Setter Property="Foreground" Value="#B25000" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
