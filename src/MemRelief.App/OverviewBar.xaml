<UserControl x:Class="MemRelief.App.OverviewBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 主题自合并：单测直构造控件时无 Application 资源上下文（同 MainWindow 口径） -->
                <ResourceDictionary Source="Themes/Modern.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 顶部内存概览条（R05/T-17）：三数值 + 口径说明文案；数据面=OverviewBarViewModel（独立子 VM，
         三时点刷新承载于该 VM，见其注释）。降级/读失败时备用位与三数值分别显示“—”。
         视觉层（T-29）：三指标芯片卡+数值主色，绑定面不变 -->
    <Border Padding="12,8,12,2">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <!-- 使用中 -->
                <Border Style="{StaticResource Card}" Padding="14,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{StaticResource Brush.Accent}" />
                        <TextBlock Margin="7,0,0,0" FontSize="13" VerticalAlignment="Center">
                            <Run Text="使用中 " Foreground="{StaticResource Brush.TextSecondary}" />
                            <Run Text="{Binding InUseText, Mode=OneWay}" FontWeight="Bold"
                                 Foreground="{StaticResource Brush.TextPrimary}" />
                            <Run Text=" / " Foreground="{StaticResource Brush.TextSecondary}" />
                            <Run Text="{Binding TotalText, Mode=OneWay}"
                                 Foreground="{StaticResource Brush.TextSecondary}" />
                            <Run Text="（" Foreground="{StaticResource Brush.TextSecondary}" />
                            <Run Text="{Binding InUsePercentText, Mode=OneWay}" FontWeight="Bold"
                                 Foreground="{StaticResource Brush.TextPrimary}" />
                            <Run Text="）" Foreground="{StaticResource Brush.TextSecondary}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <!-- 已提交 -->
                <Border Style="{StaticResource Card}" Padding="14,6" Margin="0,0,8,0">
                    <TextBlock FontSize="13" VerticalAlignment="Center">
                        <Run Text="已提交 " Foreground="{StaticResource Brush.TextSecondary}" />
                        <Run Text="{Binding CommitText, Mode=OneWay}" FontWeight="Bold"
                             Foreground="{StaticResource Brush.TextPrimary}" />
                        <Run Text=" / " Foreground="{StaticResource Brush.TextSecondary}" />
                        <Run Text="{Binding CommitLimitText, Mode=OneWay}"
                             Foreground="{StaticResource Brush.TextSecondary}" />
                    </TextBlock>
                </Border>
                <!-- 备用（可回收缓存） -->
                <Border Style="{StaticResource Card}" Padding="14,6">
                    <TextBlock FontSize="13" VerticalAlignment="Center">
                        <Run Text="备用（可回收缓存） " Foreground="{StaticResource Brush.TextSecondary}" />
                        <Run Text="{Binding StandbyText, Mode=OneWay}" FontWeight="Bold"
                             Foreground="{StaticResource Brush.TextPrimary}" />
                    </TextBlock>
                </Border>
            </StackPanel>
            <TextBlock Margin="2,4,0,0" FontSize="11" Text="{Binding NoteText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                        <Style.Triggers>
                            <!-- 读失败提示着色（深橙，红色留给扫描失败行）；降级注记保持灰 -->
                            <DataTrigger Binding="{Binding HasReadFailure}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.WarnText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
