<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CsWin32 源生成的 P/Invoke 使用 unsafe（fixed 缓冲/函数指针） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Win32 通道（system-spec §4）：CsWin32 源生成；NtQuerySystemInformation/PDH 内存通道属手写例外，不经此生成 -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333" PrivateAssets="all" />
    <!-- 他进程命令行采集经 WMI（system-spec §4 手写例外③） -->
    <PackageReference Include="System.Management" Version="10.0.11" />
    <!-- 来源采集 Run 键通道（口径 #12）：Microsoft.Win32.Registry 自 .NET 基础库内置（net10.0 直接可用，
         显式包引用触发 NU1510 冗余告警已移除）；HKLM 64/32 双视图经 RegistryView（KEY_WOW64 口径，不硬编码 Wow6432Node） -->
  </ItemGroup>

  <ItemGroup>
    <!-- 内置名单（storage T-13）：只读嵌入资源，随单文件发布（storage 法：除白名单/日志外零文件写入） -->
    <EmbeddedResource Include="Storage\Resources\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- 白盒测试（Scanner.MergeCommandLines 等 internal 纯函数的合成单测） -->
    <InternalsVisibleTo Include="MemRelief.Core.Tests" />
  </ItemGroup>

</Project>
